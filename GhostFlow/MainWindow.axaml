
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GhostFlow.MainWindow"
        Title="GhostFlow"
        Width="1150"
        Height="760"
        MinWidth="950"
        MinHeight="650"
        Background="#0B0D14"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="235,*">

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#10131D"
                BorderBrush="#202433"
                BorderThickness="0,0,1,0">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- LOGO -->
                <StackPanel Margin="25,28,20,25"
                            Orientation="Horizontal"
                            Spacing="11">

                    <Border Width="37"
                            Height="37"
                            CornerRadius="11"
                            Background="#705CF6">
                        <TextBlock Text="G"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center"
                                Spacing="1">
                        <TextBlock Text="GhostFlow"
                                   FontSize="19"
                                   FontWeight="Bold"/>
                        <TextBlock Text="AUTOMATION ENGINE"
                                   FontSize="9"
                                   Foreground="#777F96"/>
                    </StackPanel>
                </StackPanel>

                <!-- NAVIGATION AREA -->
                <StackPanel Grid.Row="1"
                            Margin="13,10,13,0"
                            Spacing="7">

                    <TextBlock Text="WORKSPACE"
                               Foreground="#646D82"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="12,0,0,8"/>

                </StackPanel>

                <!-- ENGINE STATUS -->
                <Border Grid.Row="2"
                        BorderBrush="#252A39"
                        BorderThickness="0,1,0,0"
                        Padding="18">

                    <StackPanel Spacing="9">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="9">
                            <Border Width="9"
                                    Height="9"
                                    CornerRadius="5"
                                    Background="#42D69A"
                                    VerticalAlignment="Center"/>

                            <TextBlock Text="Engine is running"
                                       FontSize="12"
                                       Foreground="#A8B1C3"/>
                        </StackPanel>

                        <TextBlock Text="GhostFlow v0.1.0"
                                   FontSize="10"
                                   Foreground="#626B7E"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,*">

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="#10131D"
                    BorderBrush="#202433"
                    BorderThickness="0,0,0,1"
                    Padding="30,19">

                <Grid ColumnDefinitions="*,Auto">

                    <StackPanel Spacing="3">
                        <TextBlock Text="Workspace"
                                   FontSize="14"
                                   Foreground="#8E96AA"/>

                        <TextBlock Text="Your automation workspace"
                                   FontSize="12"
                                   Foreground="#626B7E"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- EMPTY CONTENT AREA -->
            <Grid Grid.Row="1"
                  Margin="30">

                <!-- Add your cards here -->

            </Grid>

        </Grid>

    </Grid>
</Window>
